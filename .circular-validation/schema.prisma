generator client {
  provider = "prisma-client-js"
  output = "../../qa-artifacts/circular-validation-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model component_activity {
  componentcode         String                       @db.VarChar(20)
  componentname         String                       @db.VarChar(100)
  activitycode          String                       @db.VarChar(20)
  activityname          String                       @db.VarChar(100)
  userRoleComActivities user_role_com_activity_mst[] @relation("ComponentActivityRelation")

  @@id([componentcode, activitycode])
}

model meta_data_mst {
  screen_code    String @db.VarChar(10) // PK
  meta_code      String @db.VarChar(10) // PK
  screen_name    String @db.VarChar(50)
  meta_code_name String @db.VarChar(50)

  @@id([screen_code, meta_code])
}

model province_mst {
  province_code   String    @id @db.VarChar(10) // PK
  province_name   String    @db.VarChar(100)
  concretion_code String    @db.VarChar(10)
  short_name      String    @db.VarChar(5)
  email           String    @db.VarChar(255) // Added email field
  language_code   String?   @db.VarChar(2)
  concurrency_val Int?
  created_by      String?   @db.VarChar(50)
  created_date    DateTime?
  updated_by      String?   @db.VarChar(50)
  updated_date    DateTime?
}

model quickcode_mst {
  quick_code_type String    @db.VarChar(10) // PK
  quick_code      String    @db.VarChar(10) // PK
  quickcode_name  String    @db.VarChar(100)
  language_code   String?   @db.VarChar(2)
  concurrency_val Int?
  created_by      String?   @db.VarChar(50)
  created_date    DateTime?
  updated_by      String?   @db.VarChar(50)
  updated_date    DateTime?

  @@id([quick_code_type, quick_code])
  @@index([quickcode_name], map: "quickcode_name_idx")
}

model country_mst {
  province_code   String    @db.VarChar(10) // PK
  country_code    String    @db.VarChar(10) // PK
  country_name    String    @db.VarChar(100)
  ISD_code        String    @db.VarChar(5)
  language_code   String?   @db.VarChar(2)
  concurrency_val Int?
  created_by      String?   @db.VarChar(50)
  created_date    DateTime?
  updated_by      String?   @db.VarChar(50)
  updated_date    DateTime?

  @@id([country_code, province_code])
}

model state_mst {
  province_code   String    @db.VarChar(10) // PK
  state_code      String    @db.VarChar(10) // PK
  country_code    String    @db.VarChar(10) // PK
  state_name      String    @db.VarChar(100)
  ISD_code        String    @db.VarChar(4)
  language_code   String?   @db.VarChar(2)
  concurrency_val Int?
  created_by      String?   @db.VarChar(50)
  created_date    DateTime?
  updated_by      String?   @db.VarChar(50)
  updated_date    DateTime?

  @@id([state_code, country_code, province_code])
}

model province_country_map_mst {
  province_code      String    @db.VarChar(10) // PK
  country_code       String    @db.VarChar(10) // PK
  inter_province_chk Int
  date_format        String?   @db.VarChar(12)
  academic_year      String?   @db.VarChar(12)
  language_code      String?   @db.VarChar(2)
  concurrency_val    Int?
  created_by         String?   @db.VarChar(50)
  created_date       DateTime?
  updated_by         String?   @db.VarChar(50)
  updated_date       DateTime?

  @@id([province_code, country_code])
}

model apostolates_mst {
  province_code    String    @db.VarChar(10) // PK
  apostolate_code  String    @db.VarChar(10) // PK
  centre_type_code String    @db.VarChar(10) // PK
  apostolate_name  String    @db.VarChar(100)
  centre_type_name String    @db.VarChar(100)
  language_code    String?   @db.VarChar(2)
  concurrency_val  Int?
  created_by       String?   @db.VarChar(50)
  created_date     DateTime?
  updated_by       String?   @db.VarChar(50)
  updated_date     DateTime?

  @@id([apostolate_code, centre_type_code, province_code])
}

model users_mst {
  user_type_code      String                        @db.VarChar(100)
  prov_concre_code    String                        @db.VarChar(100)
  user_id             String                        @db.VarChar(100) @unique // ✅ Add this
  first_name          String                        @db.VarChar(100)
  last_name           String?                       @db.VarChar(100)
  password            String                        @db.VarChar(200)
  role_code           String?                       @db.VarChar(100)
  role_name           String?                       @db.VarChar(100)
  language_code       String?                       @db.VarChar(2)
  concurrency_val     Int?
  created_by          String?                       @db.VarChar(100)
  created_date        DateTime?                     @db.Timestamp(6)
  updated_by          String?                       @db.VarChar(100)
  updated_date        DateTime?                     @db.Timestamp(6)

  // ✅ Relation to activity mappings
  user_role_com_activity_mst user_role_com_activity_mst[] @relation("UserActivitiesRelation")

  @@id([user_type_code, prov_concre_code, user_id])
}
model division_setup_mst {
  province_code      String    @db.VarChar(10) // PK
  division_type_code String    @db.VarChar(50) // PK
  division_code      String    @db.VarChar(10) // PK
  division_name      String    @db.VarChar(50)
  language_code      String?   @db.VarChar(2)
  concurrency_val    Int?
  created_by         String?   @db.VarChar(50)
  created_date       DateTime?
  updated_by         String?   @db.VarChar(50)
  updated_date       DateTime?

  @@id([province_code, division_type_code, division_code])
}

model user_role_com_activity_mst {
  user_type_code    String             @db.VarChar(100)
  prov_concre_code  String             @db.VarChar(100)
  role_code         String             @db.VarChar(100)
  component_code    String             @db.VarChar(100)
  activity_code     String             @db.VarChar(100)
  role_name         String?            @db.VarChar(100)
  component_name    String?            @db.VarChar(100)
  activity_name     String?            @db.VarChar(100)
  add_flag          Boolean
  edit_flag         Boolean
  delete_flag       Boolean
  language_code     String?            @db.VarChar(2)
  concurrency_val   Int?
  created_by        String?            @db.VarChar(100)
  created_date      DateTime?
  updated_by        String?            @db.VarChar(100)
  updated_date      DateTime?
  user_id           String?            @db.VarChar(100)

  // ComponentActivity relation
  componentActivity component_activity @relation("ComponentActivityRelation", fields: [component_code, activity_code], references: [componentcode, activitycode])

  // 👇 Add this line to connect back to users_mst
  user users_mst? @relation("UserActivitiesRelation", fields: [user_id], references: [user_id])

  @@id([user_type_code, prov_concre_code, role_code, component_code, activity_code])
}

  model concretion_defination_mst {
    concretion_code String  @db.VarChar(10) // Primary Key
    concretion_name String? @db.VarChar(100)
    contact_name    String? @db.VarChar(100)
    mobile_isd      String? @db.VarChar(5)
    mobile_no       String? @db.VarChar(20) // Mobile number as String
    email           String? @db.VarChar(255)
    status          String? @db.VarChar(10) // Status (e.g., "Active", etc.)
    created_by      String? @db.VarChar(100) // The user who created the record
    created_date    DateTime?               // Date when the record was created
    updated_by      String? @db.VarChar(100) // The user who last updated the record
    updated_date    DateTime?               // Date when the record was last updated

    @@id([concretion_code]) // Composite primary key
  }



model languagemetadata {
  language_name String
  language_code String @id @unique
}

model nationalitymetadata {
