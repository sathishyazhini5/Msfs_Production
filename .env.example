# Use the existing DATABASE_URL and JWT_SECRET configuration. Never commit real credentials.

# Existing shared Gmail transport (use an app password).
GMAIL_USER=
GMAIL_PASS=
# Existing Azure account; circulars require a PRIVATE container.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
CIRCULAR_CONTAINER_NAME=msfs-circulars
# Keep disabled in development. Enable only with a supervised worker and real SMTP credentials.
CIRCULAR_WORKER_ENABLED=false
CIRCULAR_WORKER_CONCURRENCY=3

# Calendar timezone for the single birthday/ordination scheduler
APP_TIMEZONE=Asia/Kolkata

# Enable the existing daily wish job explicitly when deploying (disabled in development)
ANNIVERSARY_EMAILS_ENABLED=false

# Explicitly enable the embedded welcome outbox after reviewing pending recipients.
MEMBER_WELCOME_WORKER_ENABLED=false

# Administrative account notifications (separate envelopes from private reset mail)
ACCOUNT_AUDIT_EMAIL=sathisyazhini5@gmail.com
ACCOUNT_LOGIN_URL=http://localhost:3000/login
# Public backend origin used by session-specific security notification links
PUBLIC_API_URL=http://localhost:5000
