# Use the existing DATABASE_URL and JWT_SECRET configuration. Never commit real credentials.

# Existing shared Gmail transport (use an app password).
GMAIL_USER=
GMAIL_PASS=
# Existing Azure account; circulars require a PRIVATE container.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
CIRCULAR_CONTAINER_NAME=msfs-circulars
# Keep disabled in development. Enable only with a supervised worker and real SMTP credentials.
CIRCULAR_WORKER_ENABLED=false
CIRCULAR_WORKER_CONCURRENCY=3
